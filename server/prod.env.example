# Production environment example.
#
# Do not copy this into the repository as a real production secret file.
# On a VPS, put the real values somewhere like /etc/krino/server.env
# and load it through systemd, Docker, or your process manager.

SPRING_PROFILES_ACTIVE=prod
SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5432/krino?sslmode=require
SPRING_DATASOURCE_USERNAME=krino
SPRING_DATASOURCE_PASSWORD=replace-with-real-db-password

# Keep this as validate untilhha migration tool owns schema changes.
SPRING_JPA_HIBERNATE_DDL_AUTO=validate

#generate these using: openssl rand -hex 32
JWT_SECRET=replace-with-a-strong-random-secret-min-32-chars
APP_REFRESH_TOKEN_HMAC_SECRET=replace-with-a-different-strong-random-secret-min-32-chars

APP_JWT_ISSUER=https://api.example.com
APP_JWT_ACCESS_TOKEN_EXPIRATION=15m

# Only the browser origin(s) that should be allowed to call the API.
APP_CORS_ALLOWED_ORIGINS=https://krino.4bderrahmane.com

# Public base URL of the frontend (no trailing slash). Used to build links in emails
# (sign-in button, password-reset link).
APP_FRONTEND_URL=https://krino.4bderrahmane.com

# Required in production because auth tokens are cookies.
APP_COOKIES_SECURE=true

# Bootstrap ADMIN account, seeded once on first startup (see AdminInitializer).
# The password is hashed at startup, so put the plaintext here and never a hash.
# Once the admin exists, re-seeding is skipped; you can rotate the password via the
# change-password endpoint and remove these afterwards.
APP_ADMIN_EMAIL=admin@example.com
APP_ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Private MinIO bucket used for candidate CV/resume files.
APP_STORAGE_ENDPOINT=http://127.0.0.1:9000
APP_STORAGE_ACCESS_KEY=replace-with-minio-access-key
APP_STORAGE_SECRET_KEY=replace-with-minio-secret-key
APP_STORAGE_BUCKET=krino-cvs
APP_STORAGE_MAX_CV_SIZE=5MB

# Transactional email via Resend (used to send new staff their initial password, etc.).
# The "from" address must be on a domain you've verified in Resend.
RESEND_API_KEY=replace-with-resend-api-key
APP_MAIL_FROM=no-reply@example.com
APP_MAIL_FROM_NAME=Krino

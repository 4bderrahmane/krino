# env file example
#
# Copy this file to `server/.env` and fill in real values:
#     cp server/.env.example server/.env
#
# `.env` is git-ignored. Spring Boot binds these via relaxed binding
# (e.g. APP_COOKIES_SECURE -> app.cookies.secure). docker-compose loads
# them automatically for the `server` service (see docker-compose.yml).

SPRING_PROFILES_ACTIVE=dev

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/krino
SPRING_DATASOURCE_USERNAME=krino
SPRING_DATASOURCE_PASSWORD=password
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# Generate both of these secrets (>= 32 chars) using `openssl rand -hex 32`.
JWT_SECRET=replace-with-a-strong-random-secret-min-32-chars
APP_REFRESH_TOKEN_HMAC_SECRET=replace-with-a-strong-random-secret-min-32-chars

APP_JWT_ISSUER=krino-dev
APP_JWT_ACCESS_TOKEN_EXPIRATION=15m
APP_REFRESH_TOKEN_EXPIRATION=30d

# comma-separated list of allowed origins
APP_CORS_ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

# Public base URL of the frontend (no trailing slash). Used to build links in emails
# (sign-in button, password-reset link).
APP_FRONTEND_URL=http://localhost:5000

# true  -> Secure flag set, cookies only sent over HTTPS (use in production)
# false -> only for local plain-HTTP development
APP_COOKIES_SECURE=false

# Redis, backing the Spring cache and the rate limiter. When running with Docker
# Compose, docker-compose.yml overrides REDIS_HOST to the redis container.
REDIS_HOST=localhost
REDIS_PORT=6379

# Per-IP rate limiting for the public auth endpoints (login/register/refresh).
# CAPACITY is the burst allowed; REFILL_PERIOD is how long a drained bucket takes
# to refill back to CAPACITY (e.g. 10 over 1m -> ~10 requests/min per IP, burst 10).
APP_RATE_LIMIT_ENABLED=true
APP_RATE_LIMIT_AUTH_CAPACITY=10
APP_RATE_LIMIT_AUTH_REFILL_PERIOD=1m

# Separate, looser budget for the anonymous job catalogue (/api/public/**). One page view
# costs several requests, so the auth budget above would make normal browsing fail.
APP_RATE_LIMIT_PUBLIC_CAPACITY=120
APP_RATE_LIMIT_PUBLIC_REFILL_PERIOD=1m

# dev bootstrap admin account
APP_ADMIN_EMAIL=admin@example.com
APP_ADMIN_PASSWORD=change-me

# CV/resume storage. When running with Docker Compose, docker-compose.yml
# overrides APP_STORAGE_ENDPOINT to http://minio:9000 so the server talks to
# the MinIO container over the compose network.
APP_STORAGE_ENDPOINT=http://localhost:9000
APP_STORAGE_ACCESS_KEY=krino-minio
APP_STORAGE_SECRET_KEY=change-me-minio-password
APP_STORAGE_BUCKET=krino-cvs
APP_STORAGE_MAX_CV_SIZE=5MB
APP_STORAGE_MAX_REQUEST_SIZE=6MB

# Transactional email via Resend (new-staff initial password, etc.).
# In dev you can use Resend's onboarding sender/test key; the "from" domain must be
# verified in Resend for real delivery.
RESEND_API_KEY=replace-with-resend-api-key
APP_MAIL_FROM=onboarding@resend.dev
APP_MAIL_FROM_NAME=Krino

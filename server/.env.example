# ---------------------------------------------------------------------------
# Server environment configuration (example).
#
# Copy this file to `server/.env` and fill in real values:
#     cp server/.env.example server/.env
#
# `.env` is git-ignored. Spring Boot binds these via relaxed binding
# (e.g. APP_COOKIES_SECURE -> app.cookies.secure). docker-compose loads
# them automatically for the `server` service (see docker-compose.yml).
# ---------------------------------------------------------------------------

# --- Database (MySQL) ---
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/krino
SPRING_DATASOURCE_USERNAME=ism
SPRING_DATASOURCE_PASSWORD=change-me

# --- JWT ---
# Generate a strong random secret (>= 32 chars), e.g. `openssl rand -hex 32`.
JWT_SECRET=replace-with-a-strong-random-secret-min-32-chars

# --- Refresh tokens ---
# Generate a separate strong random secret (>= 32 chars), e.g. `openssl rand -hex 32`.
APP_REFRESH_TOKEN_HMAC_SECRET=replace-with-a-strong-random-secret-min-32-chars

APP_JWT_ISSUER=krino
APP_JWT_ACCESS_TOKEN_EXPIRATION_MS=900000

# --- CORS (comma-separated list of allowed origins) ---
APP_CORS_ALLOWED_ORIGINS=http://localhost:5000,http://localhost:5173,http://127.0.0.1:5000,http://127.0.0.1:5173

# --- Cookies ---
# true  -> Secure flag set, cookies only sent over HTTPS (use in production)
# false -> only for local plain-HTTP development
APP_COOKIES_SECURE=true

# --- Bootstrap admin account (AdminInitializer) ---
APP_ADMIN_EMAIL=admin@example.com
APP_ADMIN_PASSWORD=change-me
